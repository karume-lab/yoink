  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@biomejs/biome": "^2.5.7",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "drizzle-kit": "^0.31.10",
    "expo-doctor": "^1.20.1",
    "lefthook": "^2.1.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "NODE_NO_WARNINGS=1 expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo prebuild --clean && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check",
    "dev": "NODE_NO_WARNINGS=1 expo start --dev-client",
    "doctor": "expo-doctor --verbose",
    "update-packages": "expo install --check",
    "reinstall-packages": "rm -rf node_modules bun.lock && bun i",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build": "bun run prebuild && ./android/gradlew -p android assembleRelease",
    "prebuild": "expo prebuild --clean",
    "build:arm64": "./android/gradlew -p android assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:x86_64": "./android/gradlew -p android assembleRelease -PreactNativeArchitectures=x86_64",
    "build:universal": "./android/gradlew -p android assembleRelease -PreactNativeArchitectures=arm64-v8a,x86_64",
    "build:arm64:install": "bun run build:arm64 && bun run install-apk",
    "build:x86_64:install": "bun run build:x86_64 && bun run install-apk",
    "build:universal:install": "bun run build:universal && bun run install-apk",
    "install-apk": "adb install ./android/app/build/outputs/apk/release/app-release.apk",
    "update-apk": "adb install -r ./android/app/build/outputs/apk/release/app-release.apk",
    "build:install-apk": "bun run build && bun run install-apk"
  }
}
